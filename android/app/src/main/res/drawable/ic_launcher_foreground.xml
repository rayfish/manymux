<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a prompt, and the block cursor sitting at it.

  It says terminal at 48dp, which is the whole job of an icon on a home screen,
  and it is drawn out of the same two colours the app paints a session with. The
  adaptive foreground keeps to the inner 72dp, since everything outside that is
  the launcher's to crop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M34,36 L54,54 L34,72"
        android:strokeColor="@color/accent"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M64,40 h14 v28 h-14 z"
        android:fillColor="@color/text" />
</vector>
