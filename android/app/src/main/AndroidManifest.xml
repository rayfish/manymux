<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission there is. Everything this app does is one ssh
         connection to a machine somebody named. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Back is read in `MainActivity.onBackPressed`. From Android 15 an app
         that targets it gets predictive back by default and the platform
         delivers back through `OnBackInvokedDispatcher` instead; a plain
         activity that registers nothing there would lose the one gesture that
         gets you out of a session. The animation is worth less than that. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:label="manymux"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
